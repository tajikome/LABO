  (write-line "      <TextBlock Text=\"ブロック内部一括編集\" Foreground=\"White\" FontSize=\"16\" FontWeight=\"Bold\" VerticalAlignment=\"Center\" Margin=\"20,0,0,0\"/>" fn)
  (write-line "    </Border>" fn)
  (write-line "    <Grid Grid.Row=\"1\" Margin=\"20,16,20,20\">" fn)
  (write-line "      <Grid.RowDefinitions>" fn)
  (write-line "        <RowDefinition Height=\"Auto\"/>" fn)
  (write-line "        <RowDefinition Height=\"*\"/>" fn)
  (write-line "        <RowDefinition Height=\"Auto\"/>" fn)
  (write-line "      </Grid.RowDefinitions>" fn)
  (write-line "      <Grid.ColumnDefinitions>" fn)
  (write-line "        <ColumnDefinition Width=\"*\"/>" fn)
  (write-line "        <ColumnDefinition Width=\"28\"/>" fn)
  (write-line "        <ColumnDefinition Width=\"*\"/>" fn)
  (write-line "      </Grid.ColumnDefinitions>" fn)
  (write-line "      <TextBlock Grid.Row=\"0\" Grid.Column=\"0\" Grid.ColumnSpan=\"3\" Name=\"InfoText\" FontSize=\"13\" FontWeight=\"SemiBold\" Foreground=\"#FF424242\" Margin=\"0,0,0,16\" TextWrapping=\"Wrap\"/>" fn)
  (write-line "      <Grid Grid.Row=\"1\" Grid.Column=\"0\">" fn)
  (write-line "        <Grid.RowDefinitions>" fn)
  (write-line "          <RowDefinition Height=\"Auto\"/>" fn)
  (write-line "          <RowDefinition Height=\"*\"/>" fn)
  (write-line "          <RowDefinition Height=\"Auto\"/>" fn)
  (write-line "          <RowDefinition Height=\"*\"/>" fn)
  (write-line "        </Grid.RowDefinitions>" fn)
  (write-line "        <StackPanel Grid.Row=\"0\" Margin=\"2,0,0,8\">" fn)
  (write-line "          <TextBlock Text=\"変更後の画層\" FontSize=\"12\" FontWeight=\"Bold\" Foreground=\"#FF3F51B5\"/>" fn)
  (write-line "          <TextBlock Name=\"CurrentLayersText\" FontSize=\"11\" Foreground=\"#FF9E9E9E\" Margin=\"0,2,0,0\" TextWrapping=\"Wrap\"/>" fn)
  (write-line "        </StackPanel>" fn)
  (write-line "        <Border Grid.Row=\"1\" Background=\"White\" CornerRadius=\"6\" Margin=\"0,0,0,14\">" fn)
  (write-line "          <Border.Effect>" fn)
  (write-line "            <DropShadowEffect BlurRadius=\"6\" ShadowDepth=\"1\" Opacity=\"0.15\" Color=\"#FF000000\"/>" fn)
  (write-line "          </Border.Effect>" fn)
  (write-line "          <ListBox Name=\"LayerList\"/>" fn)
  (write-line "        </Border>" fn)
  (write-line "        <StackPanel Grid.Row=\"2\" Margin=\"2,0,0,8\">" fn)
