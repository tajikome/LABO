  (write-line "            <ControlTemplate.Triggers>" fn)
  (write-line "              <Trigger Property=\"IsMouseOver\" Value=\"True\">" fn)
  (write-line "                <Setter TargetName=\"bd\" Property=\"BorderBrush\" Value=\"#FF3F51B5\"/>" fn)
  (write-line "              </Trigger>" fn)
  (write-line "            </ControlTemplate.Triggers>" fn)
  (write-line "          </ControlTemplate>" fn)
  (write-line "        </Setter.Value>" fn)
  (write-line "      </Setter>" fn)
  (write-line "    </Style>" fn)
  (write-line "    <Style x:Key=\"FlatTextButton\" TargetType=\"Button\">" fn)
  (write-line "      <Setter Property=\"Background\" Value=\"Transparent\"/>" fn)
  (write-line "      <Setter Property=\"FontWeight\" Value=\"Bold\"/>" fn)
  (write-line "      <Setter Property=\"FontSize\" Value=\"14\"/>" fn)
  (write-line "      <Setter Property=\"BorderThickness\" Value=\"0\"/>" fn)
  (write-line "      <Setter Property=\"Padding\" Value=\"16,9\"/>" fn)
  (write-line "      <Setter Property=\"Cursor\" Value=\"Hand\"/>" fn)
  (write-line "      <Setter Property=\"Template\">" fn)
  (write-line "        <Setter.Value>" fn)
  (write-line "          <ControlTemplate TargetType=\"Button\">" fn)
  (write-line "            <Border x:Name=\"bd\" Background=\"{TemplateBinding Background}\" CornerRadius=\"4\" Padding=\"{TemplateBinding Padding}\">" fn)
  (write-line "              <ContentPresenter HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\" TextElement.Foreground=\"{TemplateBinding Foreground}\"/>" fn)
  (write-line "            </Border>" fn)
  (write-line "            <ControlTemplate.Triggers>" fn)
  (write-line "              <Trigger Property=\"IsMouseOver\" Value=\"True\">" fn)
  (write-line "                <Setter TargetName=\"bd\" Property=\"Background\" Value=\"#14000000\"/>" fn)
  (write-line "              </Trigger>" fn)
  (write-line "            </ControlTemplate.Triggers>" fn)
  (write-line "          </ControlTemplate>" fn)
  (write-line "        </Setter.Value>" fn)
  (write-line "      </Setter>" fn)
  (write-line "    </Style>" fn)
  (write-line "    <Style TargetType=\"ListBox\">" fn)
  (write-line "      <Setter Property=\"BorderThickness\" Value=\"0\"/>" fn)
  (write-line "      <Setter Property=\"Background\" Value=\"Transparent\"/>" fn)
  (write-line "    </Style>" fn)
  (write-line "    <Style TargetType=\"ListBoxItem\">" fn)
  (write-line "      <Setter Property=\"Padding\" Value=\"12,10\"/>" fn)
  (write-line "      <Setter Property=\"FontSize\" Value=\"14\"/>" fn)
  (write-line "      <Setter Property=\"Template\">" fn)
  (write-line "        <Setter.Value>" fn)
  (write-line "          <ControlTemplate TargetType=\"ListBoxItem\">" fn)
  (write-line "            <Border x:Name=\"bd\" Background=\"Transparent\" Padding=\"{TemplateBinding Padding}\" BorderBrush=\"#FFEEEEEE\" BorderThickness=\"0,0,0,1\">" fn)
  (write-line "              <ContentPresenter/>" fn)
  (write-line "            </Border>" fn)
  (write-line "            <ControlTemplate.Triggers>" fn)
  (write-line "              <Trigger Property=\"IsSelected\" Value=\"True\">" fn)
  (write-line "                <Setter TargetName=\"bd\" Property=\"Background\" Value=\"#FFC5CAE9\"/>" fn)
  (write-line "              </Trigger>" fn)
  (write-line "              <Trigger Property=\"IsMouseOver\" Value=\"True\">" fn)
  (write-line "                <Setter TargetName=\"bd\" Property=\"Background\" Value=\"#FFF5F5F5\"/>" fn)
  (write-line "              </Trigger>" fn)
  (write-line "            </ControlTemplate.Triggers>" fn)
  (write-line "          </ControlTemplate>" fn)
  (write-line "        </Setter.Value>" fn)
  (write-line "      </Setter>" fn)
  (write-line "    </Style>" fn)
  (write-line "  </Window.Resources>" fn)
  (write-line "  <Grid>" fn)
  (write-line "    <Grid.RowDefinitions>" fn)
  (write-line "      <RowDefinition Height=\"56\"/>" fn)
  (write-line "      <RowDefinition Height=\"*\"/>" fn)
  (write-line "    </Grid.RowDefinitions>" fn)
  (write-line "    <Border Grid.Row=\"0\" Background=\"#FF3F51B5\">" fn)
  (write-line "      <Border.Effect>" fn)
  (write-line "        <DropShadowEffect BlurRadius=\"8\" ShadowDepth=\"2\" Direction=\"270\" Opacity=\"0.3\" Color=\"#FF000000\"/>" fn)
