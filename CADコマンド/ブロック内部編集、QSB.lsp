  (write-line "      <Setter Property=\"Margin\" Value=\"0,3,0,0\"/>" fn)
  (write-line "      <Setter Property=\"TextTrimming\" Value=\"CharacterEllipsis\"/>" fn)
  (write-line "    </Style>" fn)
  (write-line "    <Style x:Key=\"Chip\" TargetType=\"Button\">" fn)
  (write-line "      <Setter Property=\"Background\" Value=\"#FFFFFF\"/>" fn)
  (write-line "      <Setter Property=\"Foreground\" Value=\"#344054\"/>" fn)
  (write-line "      <Setter Property=\"BorderBrush\" Value=\"#D0D5DD\"/>" fn)
  (write-line "      <Setter Property=\"Padding\" Value=\"11,4\"/>" fn)
  (write-line "      <Setter Property=\"Margin\" Value=\"0,0,6,6\"/>" fn)
  (write-line "      <Setter Property=\"FontSize\" Value=\"12\"/>" fn)
