  (write-line "# ---------- マイクロインタラクション用ヘルパー ----------" fn)
  (write-line "function New-DoubleAnim ($from, $to, $ms, $delayMs) {" fn)
  (write-line "    $a = New-Object System.Windows.Media.Animation.DoubleAnimation" fn)
  (write-line "    if ($null -ne $from) { $a.From = [double]$from }" fn)
  (write-line "    $a.To = [double]$to" fn)
  (write-line "    $a.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds($ms))" fn)
  (write-line "    if ($delayMs) { $a.BeginTime = [TimeSpan]::FromMilliseconds($delayMs) }" fn)
  (write-line "    $a.DecelerationRatio = 0.8" fn)
  (write-line "    return $a" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function Start-TextPulse ($tb) {" fn)
  (write-line "    try {" fn)
  (write-line "        $tt = New-Object System.Windows.Media.TranslateTransform" fn)
  (write-line "        $tb.RenderTransform = $tt" fn)
  (write-line "        $tb.BeginAnimation([System.Windows.UIElement]::OpacityProperty, (New-DoubleAnim 0.2 1 220 0))" fn)
  (write-line "        $tt.BeginAnimation([System.Windows.Media.TranslateTransform]::XProperty, (New-DoubleAnim 8 0 220 0))" fn)
  (write-line "    } catch { }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "$script:previewBrush = New-Object System.Windows.Media.SolidColorBrush ([System.Windows.Media.Color]::FromArgb(0,255,255,255))" fn)
  (write-line "$colorPreview.Fill = $script:previewBrush" fn)
  (write-line "function Set-PreviewColor ($a, $r, $g, $b) {" fn)
  (write-line "    try {" fn)
  (write-line "        $anim = New-Object System.Windows.Media.Animation.ColorAnimation" fn)
  (write-line "        $anim.To = [System.Windows.Media.Color]::FromArgb([byte]$a, [byte]$r, [byte]$g, [byte]$b)" fn)
  (write-line "        $anim.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds(240))" fn)
  (write-line "        $anim.DecelerationRatio = 0.8" fn)
  (write-line "        $script:previewBrush.BeginAnimation([System.Windows.Media.SolidColorBrush]::ColorProperty, $anim)" fn)
  (write-line "    } catch { }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function Set-ActiveChip ($container, $key) {" fn)
  (write-line "    foreach ($c in $container.Children) {" fn)
  (write-line "        if ($c -is [System.Windows.Controls.Button]) {" fn)
  (write-line "            if ($c.Uid -eq $key) { $c.Tag = 'sel' } elseif ($c.Tag -eq 'sel') { $c.Tag = $null }" fn)
  (write-line "        }" fn)
  (write-line "    }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function Start-Shake ($el, $tt) {" fn)
  (write-line "    try {" fn)
  (write-line "        $kf = New-Object System.Windows.Media.Animation.DoubleAnimationUsingKeyFrames" fn)
  (write-line "        $kf.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds(320))" fn)
  (write-line "        foreach ($p in @(@(0,0), @(60,-6), @(120,6), @(180,-4), @(240,3), @(320,0))) {" fn)
  (write-line "            $f = New-Object System.Windows.Media.Animation.LinearDoubleKeyFrame" fn)
  (write-line "            $f.Value = [double]$p[1]" fn)
  (write-line "            $f.KeyTime = [System.Windows.Media.Animation.KeyTime]::FromTimeSpan([TimeSpan]::FromMilliseconds($p[0]))" fn)
  (write-line "            [void]$kf.KeyFrames.Add($f)" fn)
  (write-line "        }" fn)
  (write-line "        $tt.BeginAnimation([System.Windows.Media.TranslateTransform]::XProperty, $kf)" fn)
  (write-line "    } catch { }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function Start-Entrance {" fn)
  (write-line "    $delay = 0" fn)
  (write-line "    foreach ($item in @(@('AppBar', -14), @('LeftCol', 16), @('RightCol', 16), @('ButtonBar', 12))) {" fn)
  (write-line "        $el = $window.FindName($item[0])" fn)
  (write-line "        if ($null -eq $el) { continue }" fn)
  (write-line "        try {" fn)
  (write-line "            $tt = New-Object System.Windows.Media.TranslateTransform" fn)
  (write-line "            $el.RenderTransform = $tt" fn)
  (write-line "            $el.Opacity = 0" fn)
  (write-line "            $el.BeginAnimation([System.Windows.UIElement]::OpacityProperty, (New-DoubleAnim 0 1 280 $delay))" fn)
  (write-line "            $tt.BeginAnimation([System.Windows.Media.TranslateTransform]::YProperty, (New-DoubleAnim $item[1] 0 320 $delay))" fn)
  (write-line "        } catch {" fn)
  (write-line "            $el.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $null)" fn)
  (write-line "            $el.Opacity = 1" fn)
  (write-line "        }" fn)
  (write-line "        $delay += 70" fn)
  (write-line "    }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "$script:closing = $false" fn)
  (write-line "function Close-Animated ($tag) {" fn)
  (write-line "    if ($script:closing) { return }" fn)
  (write-line "    $script:closing = $true" fn)
  (write-line "    $window.Tag = $tag" fn)
  (write-line "    try {" fn)
  (write-line "        $a = New-DoubleAnim $null 0 140 0" fn)
  (write-line "        $a.Add_Completed({ $window.Close() })" fn)
  (write-line "        $rootGrid.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $a)" fn)
  (write-line "    } catch {" fn)
  (write-line "        $window.Close()" fn)
  (write-line "    }" fn)
