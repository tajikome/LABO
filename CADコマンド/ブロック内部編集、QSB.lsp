  (write-line "function Format-CurrentList ($arr) {" fn)
  (write-line "    if ($arr -and $arr.Count -gt 0) { return \"現在: \" + ($arr -join ', ') }" fn)
  (write-line "    return \"現在: (なし)\"" fn)
  (write-line "}" fn)
