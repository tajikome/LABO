  (write-line "    $swatch.ToolTip = \"色番号 $i\"" fn)
  (write-line "    $swatch.Uid = \"$i\"" fn)
  (write-line "    $swatch.Background = New-Object System.Windows.Media.SolidColorBrush([System.Windows.Media.Color]::FromRgb([byte]$rgb[0],[byte]$rgb[1],[byte]$rgb[2]))" fn)
  (write-line "    $swatch.Add_Click({" fn)
  (write-line "        $idx = [int]$args[0].Uid" fn)
  (write-line "        Set-SelectedColor \"$idx\" \"色番号 $idx\" (Get-AciRgb $idx)" fn)
  (write-line "    })" fn)
  (write-line "    [void]$colorWrap.Children.Add($swatch)" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "[void](New-Chip $lineweightPanel $noChange 'NONE' { Set-SelectedLineweight $null $noChange })" fn)
  (write-line "[void](New-Chip $lineweightPanel 'ByLayer' 'BYLAYER' { Set-SelectedLineweight 'BYLAYER' 'ByLayer' })" fn)
  (write-line "[void](New-Chip $lineweightPanel 'ByBlock' 'BYBLOCK' { Set-SelectedLineweight 'BYBLOCK' 'ByBlock' })" fn)
  (write-line "" fn)
  (write-line "$lwInput = New-Object System.Windows.Controls.TextBox" fn)
  (write-line "$lwInput.Style = $textBoxStyle" fn)
  (write-line "$lwInput.Width = 70" fn)
  (write-line "$lwInput.Height = 32" fn)
  (write-line "$lwInput.Margin = [System.Windows.Thickness]'0,0,8,8'" fn)
  (write-line "$lwInput.ToolTip = 'mm単位で入力(例: 0.25)'" fn)
  (write-line "$lwShift = New-Object System.Windows.Media.TranslateTransform" fn)
  (write-line "$lwInput.RenderTransform = $lwShift" fn)
  (write-line "$lwInput.Add_TextChanged({ $lwInput.Tag = $null })" fn)
  (write-line "[void]$lineweightPanel.Children.Add($lwInput)" fn)
  (write-line "" fn)
  (write-line "[void](New-Chip $lineweightPanel 'mmで設定' 'CUSTOM' {" fn)
  (write-line "    $mmVal = 0.0" fn)
  (write-line "    if ([double]::TryParse($lwInput.Text, [ref]$mmVal)) {" fn)
  (write-line "        $lwInput.Tag = $null" fn)
  (write-line "        $raw = [int][math]::Round($mmVal * 100)" fn)
  (write-line "        Set-SelectedLineweight \"$raw\" \"$($mmVal)mm\"" fn)
  (write-line "    } else {" fn)
  (write-line "        $lwInput.Tag = 'err'" fn)
  (write-line "        Start-Shake $lwInput $lwShift" fn)
  (write-line "    }" fn)
  (write-line "})" fn)
  (write-line "" fn)
  (write-line "Set-SelectedColor $null $noChange $null" fn)
  (write-line "Set-SelectedLineweight $null $noChange" fn)
  (write-line "" fn)
  (write-line "$window.Tag = 'CANCEL'" fn)
  (write-line "$window.Add_Loaded({ Start-Entrance })" fn)
  (write-line "$applyButton.Add_Click({ Close-Animated 'OK' })" fn)
  (write-line "$cancelButton.Add_Click({ Close-Animated 'CANCEL' })" fn)
  (write-line "" fn)
  (write-line "[void]$window.ShowDialog()" fn)
  (write-line "" fn)
  (write-line "$result = @()" fn)
  (write-line "if ($window.Tag -eq 'OK') {" fn)
  (write-line "    $selLayer = $layerList.SelectedItem" fn)
  (write-line "    $selLtype = $ltypeList.SelectedItem" fn)
  (write-line "    if ($selLayer -and $selLayer -ne $noChange) { $result += \"LAYER=$selLayer\" }" fn)
  (write-line "    if ($selLtype -and $selLtype -ne $noChange) { $result += \"LTYPE=$selLtype\" }" fn)
  (write-line "    if ($script:selectedColor) { $result += \"COLOR=$($script:selectedColor)\" }" fn)
  (write-line "    if ($script:selectedLineweight) { $result += \"LWT=$($script:selectedLineweight)\" }" fn)
  (write-line "} else {" fn)
  (write-line "    $result += 'CANCEL'" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "Set-Content -LiteralPath $OutputPath -Value $result -Encoding Default" fn)
  (close fn)
  (princ)
)

;; --- 選択エンティティから対象ブロック名(EffectiveName)一覧を得る -------
(defun qsbc-get-selected-block-names (ss / n i ent obj name names)
  (setq names '())
  (setq n (sslength ss))
  (setq i 0)
  (while (< i n)
    (setq ent (ssname ss i))
    (setq obj (vlax-ename->vla-object ent))
    (setq name (vla-get-EffectiveName obj))
    (if (not (member name names)) (setq names (cons name names)))
    (setq i (1+ i))
  )
  names
)

;; --- ブロック定義内の全エンティティを集める(recursive時は入れ子ブロックも展開) --
(defun qsbc-collect-entities (blkName recursive visited / doc blocks blk obj result nestedName blkResult)
  (if (member (strcase blkName) visited)
    '()
    (progn
      (setq visited (cons (strcase blkName) visited))
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (setq blocks (vla-get-Blocks doc))
      (setq result '())
      (setq blkResult (vl-catch-all-apply 'vla-item (list blocks blkName)))
      (if (not (vl-catch-all-error-p blkResult))
        (progn
          (setq blk blkResult)
          (vlax-for obj blk
            (setq result (cons obj result))
            (if (and recursive (= (vla-get-ObjectName obj) "AcDbBlockReference"))
              (progn
                (setq nestedName (vla-get-EffectiveName obj))
                (setq result (append result (qsbc-collect-entities nestedName recursive visited)))
              )
            )
          )
        )
      )
      result
    )
  )
)

;; --- 色番号・線の太さを表示用文字列に変換 -------------------------------
(defun qsbc-color-to-str (val)
  (cond
    ((= val 0) "ByBlock")
    ((= val 256) "ByLayer")
    (T (itoa val))
  )
)
(defun qsbc-lwt-to-str (val)
  (cond
    ((= val -1) "ByLayer")
    ((= val -2) "ByBlock")
    ((= val -3) "既定")
    (T (strcat (rtos (/ val 100.0) 2 2) "mm"))
  )
)

;; --- 対象ブロック名すべてから、実体一覧・画層一覧・線種一覧・色一覧・線の太さ一覧を集計 --
(defun qsbc-gather-data (blockNames recursive / allEntities bn layers ltypes colors lwts lay lt col lw colStr lwStr obj)
  (setq allEntities '())
  (foreach bn blockNames
    (setq allEntities (append allEntities (qsbc-collect-entities bn recursive '())))
  )
  (setq layers '() ltypes '() colors '() lwts '())
  (foreach obj allEntities
    (setq lay (vla-get-Layer obj))
    (if (not (member lay layers)) (setq layers (cons lay layers)))
    (setq lt (vla-get-Linetype obj))
    (if (not (member lt ltypes)) (setq ltypes (cons lt ltypes)))
    (setq col (vla-get-Color obj))
    (setq colStr (qsbc-color-to-str col))
    (if (not (member colStr colors)) (setq colors (cons colStr colors)))
    (setq lw (vla-get-Lineweight obj))
    (setq lwStr (qsbc-lwt-to-str lw))
    (if (not (member lwStr lwts)) (setq lwts (cons lwStr lwts)))
  )
  (list allEntities (reverse layers) (reverse ltypes) (reverse colors) (reverse lwts))
)

;; --- 入力ファイル書き出し ---------------------------------------------
(defun qsbc-write-input-file (path layers ltypes colors lwts entCount blkCount / fn)
  (setq fn (open path "w"))
  (write-line "###LAYERS###" fn)
  (foreach l layers (write-line l fn))
  (write-line "###LTYPES###" fn)
  (foreach l ltypes (write-line l fn))
  (write-line "###COLORS###" fn)
  (foreach c colors (write-line c fn))
  (write-line "###LWTS###" fn)
  (foreach l lwts (write-line l fn))
  (write-line "###ENTCOUNT###" fn)
  (write-line (itoa entCount) fn)
  (write-line "###BLKCOUNT###" fn)
  (write-line (itoa blkCount) fn)
  (close fn)
  (princ)
)

;; --- 出力ファイル読み込み ---------------------------------------------
(defun qsbc-read-output-file (path / fn line result)
  (setq result '())
  (if (findfile path)
    (progn
      (setq fn (open path "r"))
      (while (setq line (read-line fn))
        (setq result (cons line result))
      )
      (close fn)
    )
  )
  (reverse result)
)

;; --- 収集したエンティティに画層・線種・色・線の太さを反映。戻り値は (成功数 失敗数) --
(defun qsbc-apply-changes (entities newLayer newLtype colorSpec lineweightSpec / okCnt errCnt obj res)
  (setq okCnt 0 errCnt 0)
  (foreach obj entities
    (setq res
      (vl-catch-all-apply
        '(lambda ()
           (if newLayer (vla-put-Layer obj newLayer))
           (if newLtype (vla-put-Linetype obj newLtype))
           (cond
             ((= colorSpec "BYLAYER") (vla-put-Color obj 256))
             ((= colorSpec "BYBLOCK") (vla-put-Color obj 0))
             (colorSpec (vla-put-Color obj (atoi colorSpec)))
           )
           (cond
             ((= lineweightSpec "BYLAYER") (vla-put-Lineweight obj -1))
             ((= lineweightSpec "BYBLOCK") (vla-put-Lineweight obj -2))
             (lineweightSpec (vla-put-Lineweight obj (atoi lineweightSpec)))
           )
         )
        nil
      )
    )
    (if (vl-catch-all-error-p res)
      (setq errCnt (1+ errCnt))
      (setq okCnt (1+ okCnt))
    )
  )
  (list okCnt errCnt)
)

;; --- メインコマンド ----------------------------------------------------
(defun c:qsbc ( / ss recursive blockNames blkCount data allEntities layers ltypes
                colors lwts entCount tmpDir inFile outFile ps1File outLines newLayer newLtype
                colorSpec lineweightSpec item eqPos key val applyResult)
  (setq ss (ssget '((0 . "INSERT"))))
  (if (not ss)
    (princ "\n編集対象のブロックが見つかりません。")
    (progn
      (setq recursive T)

      (setq blockNames (qsbc-get-selected-block-names ss))
      (setq blkCount (length blockNames))

      (setq data (qsbc-gather-data blockNames recursive))
      (setq allEntities (nth 0 data))
      (setq layers (nth 1 data))
      (setq ltypes (nth 2 data))
      (setq colors (nth 3 data))
      (setq lwts (nth 4 data))
      (setq entCount (length allEntities))

      (if (= entCount 0)
        (princ "\n対象となる図形が見つかりませんでした。")
        (progn
          (setq tmpDir (getenv "TEMP"))
          (setq inFile (strcat tmpDir "\\qsbc_input.txt"))
          (setq outFile (strcat tmpDir "\\qsbc_output.txt"))
          (setq ps1File (strcat tmpDir "\\qsbc_dialog.ps1"))

          (qsbc-write-input-file inFile layers ltypes colors lwts entCount blkCount)
          (qsbc-write-ps1-script ps1File)
          (qsbc-run-ps1 ps1File inFile outFile)

          (setq outLines (qsbc-read-output-file outFile))
          (setq newLayer nil newLtype nil colorSpec nil lineweightSpec nil)

          (if (and outLines (not (member "CANCEL" outLines)))
            (progn
              (foreach item outLines
                (setq eqPos (vl-string-search "=" item))
                (if eqPos
                  (progn
                    (setq key (substr item 1 eqPos))
                    (setq val (substr item (+ 2 eqPos)))
                    (cond
                      ((= key "LAYER") (setq newLayer val))
                      ((= key "LTYPE") (setq newLtype val))
                      ((= key "COLOR") (setq colorSpec val))
                      ((= key "LWT") (setq lineweightSpec val))
                    )
                  )
                )
              )
              (if (or newLayer newLtype colorSpec lineweightSpec)
                (progn
                  (setq applyResult (qsbc-apply-changes allEntities newLayer newLtype colorSpec lineweightSpec))
                  (command "_.REGENALL")
                  (princ (strcat "\n" (itoa (nth 0 applyResult)) "個の図形を更新しました。"))
                  (if (> (nth 1 applyResult) 0)
                    (princ (strcat "(" (itoa (nth 1 applyResult)) "個は変更できませんでした)"))
                  )
                )
                (princ "\n変更項目が選択されなかったため、何も更新しませんでした。")
              )
            )
            (princ "\nキャンセルされました。")
          )

          (if (findfile inFile) (vl-file-delete inFile))
          (if (findfile outFile) (vl-file-delete outFile))
          (if (findfile ps1File) (vl-file-delete ps1File))
        )
      )
    )
  )
  (princ)
)

(princ "\nQSBCコマンドをロードしました。ブロック内部の画層・線種・色・線の太さを一括変更するには 'QSBC' と入力してください。")
(princ)