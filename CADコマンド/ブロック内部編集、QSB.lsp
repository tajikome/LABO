  (write-line "          <TextBlock Name=\"CurrentLtypesText\" FontSize=\"11\" Foreground=\"#FF9E9E9E\" Margin=\"0,2,0,0\" TextWrapping=\"Wrap\"/>" fn)
  (write-line "        </StackPanel>" fn)
  (write-line "        <Border Grid.Row=\"3\" Background=\"White\" CornerRadius=\"6\">" fn)
  (write-line "          <Border.Effect>" fn)
  (write-line "            <DropShadowEffect BlurRadius=\"6\" ShadowDepth=\"1\" Opacity=\"0.15\" Color=\"#FF000000\"/>" fn)
  (write-line "          </Border.Effect>" fn)
  (write-line "          <ListBox Name=\"LtypeList\"/>" fn)
  (write-line "        </Border>" fn)
  (write-line "      </Grid>" fn)
  (write-line "      <Grid Grid.Row=\"1\" Grid.Column=\"2\">" fn)
