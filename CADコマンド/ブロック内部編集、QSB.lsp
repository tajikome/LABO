  (write-line "    $script:lw = $val" fn)
  (write-line "    $key = $NONE" fn)
  (write-line "    if ($val) { $key = $val }" fn)
  (write-line "    Set-ActiveChip $LwQuick $key 'sel'" fn)
  (write-line "    Set-ActiveChip $LwValues $key 'sel'" fn)
  (write-line "    Update-Summary" fn)
  (write-line "}" fn)
  (write-line "$lwClick = { param($s, $e) if ($s.Uid -eq $NONE) { Set-SelectedLineweight $null } else { Set-SelectedLineweight $s.Uid } }" fn)
  (write-line "[void](New-Chip $LwQuick '変更しない' $NONE $lwClick)" fn)
  (write-line "[void](New-Chip $LwQuick 'ByLayer' 'BYLAYER' $lwClick)" fn)
  (write-line "[void](New-Chip $LwQuick 'ByBlock' 'BYBLOCK' $lwClick)" fn)
  (write-line "[void](New-Chip $LwQuick '既定' 'DEFAULT' $lwClick)" fn)
  (write-line "foreach ($raw in @(0, 5, 9, 13, 15, 18, 20, 25, 30, 35, 40, 50, 53, 60, 70, 80, 90, 100, 106, 120, 140, 158, 200, 211)) {" fn)
  (write-line "    $b = New-Chip $LwValues ('{0:0.00}' -f ($raw / 100.0)) \"$raw\" $lwClick" fn)
  (write-line "    $b.Padding = New-Object System.Windows.Thickness(9,3,9,3)" fn)
  (write-line "    $b.MinWidth = 46" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "# ---------- ハッチング・ソリッド ----------" fn)
  (write-line "$script:hs = @{ HATCH = 'KEEP'; FILL = 'KEEP'; SOLID = 'KEEP' }" fn)
  (write-line "$hsTitles = @{ HATCH = 'パターンハッチング'; FILL = '塗りつぶしハッチング'; SOLID = '2Dソリッド' }" fn)
  (write-line "$hsPanels = @{}" fn)
  (write-line "function Set-HsAction ($kind, $act) {" fn)
  (write-line "    $script:hs[$kind] = $act" fn)
  (write-line "    $tag = 'sel'" fn)
  (write-line "    if ($act -eq 'DELETE') { $tag = 'danger' }" fn)
  (write-line "    Set-ActiveChip $hsPanels[$kind] \"${kind}:$act\" $tag" fn)
  (write-line "    Update-Summary" fn)
  (write-line "}" fn)
  (write-line "$hsClick = { param($s, $e) $p = $s.Uid.Split(':'); Set-HsAction $p[0] $p[1] }" fn)
  (write-line "function New-HsRow ($kind, $count) {" fn)
  (write-line "    $dp = New-Object System.Windows.Controls.DockPanel" fn)
  (write-line "    $dp.Margin = New-Object System.Windows.Thickness(0,0,0,8)" fn)
  (write-line "    $chips = New-Object System.Windows.Controls.WrapPanel" fn)
  (write-line "    [System.Windows.Controls.DockPanel]::SetDock($chips, [System.Windows.Controls.Dock]::Right)" fn)
  (write-line "    [void](New-Chip $chips 'そのまま' \"${kind}:KEEP\" $hsClick)" fn)
  (write-line "    [void](New-Chip $chips '分解' \"${kind}:EXPLODE\" $hsClick)" fn)
  (write-line "    [void](New-Chip $chips '削除' \"${kind}:DELETE\" $hsClick)" fn)
  (write-line "    [void]$dp.Children.Add($chips)" fn)
  (write-line "    $sp = New-Object System.Windows.Controls.StackPanel" fn)
  (write-line "    $sp.Orientation = [System.Windows.Controls.Orientation]::Horizontal" fn)
  (write-line "    $sp.VerticalAlignment = [System.Windows.VerticalAlignment]::Top" fn)
  (write-line "    $sp.Margin = New-Object System.Windows.Thickness(0,3,0,0)" fn)
  (write-line "    [void]$sp.Children.Add((New-Text $hsTitles[$kind] 13 '#344054' $true))" fn)
  (write-line "    if ($count -gt 0) { $badge = New-Badge \"$count\" '#EFF4FF' '#1D4ED8' } else { $badge = New-Badge 'なし' '#F2F4F7' '#667085' }" fn)
  (write-line "    $badge.Margin = New-Object System.Windows.Thickness(8,0,0,0)" fn)
  (write-line "    [void]$sp.Children.Add($badge)" fn)
  (write-line "    [void]$dp.Children.Add($sp)" fn)
  (write-line "    if ($count -le 0) { $chips.IsEnabled = $false; $chips.Opacity = 0.45 }" fn)
  (write-line "    [void]$HsPanel.Children.Add($dp)" fn)
  (write-line "    $hsPanels[$kind] = $chips" fn)
  (write-line "}" fn)
  (write-line "New-HsRow 'HATCH' $cntHatch" fn)
  (write-line "New-HsRow 'FILL' $cntFill" fn)
  (write-line "New-HsRow 'SOLID' $cntSolid" fn)
  (write-line "" fn)
  (write-line "$script:scope = 'ALL'" fn)
  (write-line "$scopeTitles = @{ ALL = 'すべての図形'; HS = 'ハッチング・ソリッドのみ'; OTHER = 'それ以外のみ' }" fn)
  (write-line "function Set-Scope ($val) {" fn)
  (write-line "    $script:scope = $val" fn)
  (write-line "    Set-ActiveChip $ScopePanel $val 'sel'" fn)
  (write-line "    Update-Summary" fn)
  (write-line "}" fn)
  (write-line "$scopeClick = { param($s, $e) Set-Scope $s.Uid }" fn)
  (write-line "foreach ($k in 'ALL', 'HS', 'OTHER') { [void](New-Chip $ScopePanel $scopeTitles[$k] $k $scopeClick) }" fn)
  (write-line "if (($cntHatch + $cntFill + $cntSolid) -le 0) { $ScopeBox.Visibility = 'Collapsed' }" fn)
  (write-line "" fn)
  (write-line "# ---------- 変更内容 ----------" fn)
  (write-line "function Add-SummaryRow ($label, $value, $danger) {" fn)
  (write-line "    $g = New-Object System.Windows.Controls.Grid" fn)
  (write-line "    $g.Margin = New-Object System.Windows.Thickness(0,0,0,8)" fn)
  (write-line "    $c0 = New-Object System.Windows.Controls.ColumnDefinition" fn)
  (write-line "    $c0.Width = New-Object System.Windows.GridLength(140)" fn)
  (write-line "    $c1 = New-Object System.Windows.Controls.ColumnDefinition" fn)
  (write-line "    [void]$g.ColumnDefinitions.Add($c0)" fn)
  (write-line "    [void]$g.ColumnDefinitions.Add($c1)" fn)
  (write-line "    $l = New-Text $label 12 '#667085' $false" fn)
  (write-line "    $l.VerticalAlignment = [System.Windows.VerticalAlignment]::Top" fn)
  (write-line "    $fg = '#101828'" fn)
  (write-line "    if ($danger) { $fg = '#B42318' }" fn)
  (write-line "    $v = New-Text ([char]0x2192 + ' ' + $value) 13 $fg $true" fn)
  (write-line "    $v.TextWrapping = [System.Windows.TextWrapping]::Wrap" fn)
  (write-line "    [System.Windows.Controls.Grid]::SetColumn($v, 1)" fn)
  (write-line "    [void]$g.Children.Add($l)" fn)
  (write-line "    [void]$g.Children.Add($v)" fn)
  (write-line "    [void]$SummaryPanel.Children.Add($g)" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "$script:ready = $false" fn)
  (write-line "function Update-Summary {" fn)
  (write-line "    if (-not $script:ready) { return }" fn)
  (write-line "    $SummaryPanel.Children.Clear()" fn)
  (write-line "    $n = 0" fn)
  (write-line "    $v = Get-ListValue $LayerList" fn)
  (write-line "    if ($v) { Add-SummaryRow '画層' $v $false; $n++ }" fn)
  (write-line "    $v = Get-ListValue $LtypeList" fn)
  (write-line "    if ($v) { Add-SummaryRow '線種' $v $false; $n++ }" fn)
  (write-line "    if ($script:color) { Add-SummaryRow '色' (Get-ColorLabel $script:color) $false; $n++ }" fn)
  (write-line "    if ($script:lw) { Add-SummaryRow '線の太さ' (Get-LwLabel $script:lw) $false; $n++ }" fn)
  (write-line "    if ($n -gt 0 -and $script:scope -ne 'ALL') { Add-SummaryRow '適用先' $scopeTitles[$script:scope] $false }" fn)
  (write-line "    foreach ($k in 'HATCH', 'FILL', 'SOLID') {" fn)
  (write-line "        if ($script:hs[$k] -eq 'EXPLODE') { Add-SummaryRow $hsTitles[$k] '分解（輪郭線へ）' $false; $n++ }" fn)
  (write-line "        elseif ($script:hs[$k] -eq 'DELETE') { Add-SummaryRow $hsTitles[$k] '削除' $true; $n++ }" fn)
  (write-line "    }" fn)
  (write-line "    if ($n -eq 0) {" fn)
  (write-line "        $t = New-Text '変更する項目を選んでください。' 12 '#98A2B3' $false" fn)
  (write-line "        $t.TextWrapping = [System.Windows.TextWrapping]::Wrap" fn)
  (write-line "        [void]$SummaryPanel.Children.Add($t)" fn)
  (write-line "    }" fn)
  (write-line "    $ApplyBtn.IsEnabled = ($n -gt 0)" fn)
  (write-line "}" fn)
  (write-line "$LayerList.Add_SelectionChanged({ Update-Summary })" fn)
  (write-line "$LtypeList.Add_SelectionChanged({ Update-Summary })" fn)
  (write-line "" fn)
  (write-line "# ---------- アニメーション ----------" fn)
  (write-line "function New-DoubleAnim ($from, $to, $ms, $delayMs) {" fn)
  (write-line "    $a = New-Object System.Windows.Media.Animation.DoubleAnimation" fn)
  (write-line "    if ($null -ne $from) { $a.From = [double]$from }" fn)
  (write-line "    $a.To = [double]$to" fn)
  (write-line "    $a.Duration = New-Object System.Windows.Duration ([TimeSpan]::FromMilliseconds($ms))" fn)
  (write-line "    if ($delayMs) { $a.BeginTime = [TimeSpan]::FromMilliseconds($delayMs) }" fn)
  (write-line "    $a.DecelerationRatio = 0.8" fn)
  (write-line "    return $a" fn)
  (write-line "}" fn)
  (write-line "function Start-Entrance {" fn)
  (write-line "    $delay = 0" fn)
  (write-line "    foreach ($el in @($Col1, $Col2, $Col3)) {" fn)
  (write-line "        try {" fn)
  (write-line "            $tt = New-Object System.Windows.Media.TranslateTransform" fn)
  (write-line "            $el.RenderTransform = $tt" fn)
  (write-line "            $el.Opacity = 0" fn)
  (write-line "            $el.BeginAnimation([System.Windows.UIElement]::OpacityProperty, (New-DoubleAnim 0 1 260 $delay))" fn)
  (write-line "            $tt.BeginAnimation([System.Windows.Media.TranslateTransform]::YProperty, (New-DoubleAnim 14 0 300 $delay))" fn)
  (write-line "        } catch {" fn)
  (write-line "            $el.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $null)" fn)
  (write-line "            $el.Opacity = 1" fn)
  (write-line "        }" fn)
  (write-line "        $delay += 60" fn)
  (write-line "    }" fn)
  (write-line "}" fn)
  (write-line "$script:closing = $false" fn)
  (write-line "function Close-Animated ($tag) {" fn)
  (write-line "    if ($script:closing) { return }" fn)
  (write-line "    $script:closing = $true" fn)
  (write-line "    $window.Tag = $tag" fn)
  (write-line "    try {" fn)
  (write-line "        $a = New-DoubleAnim $null 0 130 0" fn)
  (write-line "        $a.Add_Completed({ $window.Close() })" fn)
  (write-line "        $RootGrid.BeginAnimation([System.Windows.UIElement]::OpacityProperty, $a)" fn)
  (write-line "    } catch {" fn)
  (write-line "        $window.Close()" fn)
  (write-line "    }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "$script:ready = $true" fn)
  (write-line "Set-SelectedColor $null" fn)
  (write-line "Set-SelectedLineweight $null" fn)
  (write-line "Set-HsAction 'HATCH' 'KEEP'" fn)
  (write-line "Set-HsAction 'FILL' 'KEEP'" fn)
  (write-line "Set-HsAction 'SOLID' 'KEEP'" fn)
  (write-line "Set-Scope 'ALL'" fn)
  (write-line "" fn)
  (write-line "$window.Tag = 'CANCEL'" fn)
  (write-line "$window.Add_Loaded({ Start-Entrance })" fn)
  (write-line "$ApplyBtn.Add_Click({ Close-Animated 'OK' })" fn)
  (write-line "$CancelBtn.Add_Click({ Close-Animated 'CANCEL' })" fn)
  (write-line "$window.Add_PreviewKeyDown({ param($s, $e)" fn)
  (write-line "    if ($e.Key -eq 'Escape') {" fn)
  (write-line "        Close-Animated 'CANCEL'" fn)
  (write-line "        $e.Handled = $true" fn)
  (write-line "    } elseif ($e.Key -eq 'Return' -and -not ([System.Windows.Input.Keyboard]::FocusedElement -is [System.Windows.Controls.TextBox])) {" fn)
  (write-line "        if ($ApplyBtn.IsEnabled) { Close-Animated 'OK' }" fn)
  (write-line "        $e.Handled = $true" fn)
  (write-line "    }" fn)
  (write-line "})" fn)
  (write-line "" fn)
  (write-line "[void]$window.ShowDialog()" fn)
  (write-line "" fn)
  (write-line "$result = @()" fn)
  (write-line "if ($window.Tag -eq 'OK') {" fn)
  (write-line "    $v = Get-ListValue $LayerList" fn)
  (write-line "    if ($v) { $result += \"LAYER=$v\" }" fn)
  (write-line "    $v = Get-ListValue $LtypeList" fn)
  (write-line "    if ($v) { $result += \"LTYPE=$v\" }" fn)
  (write-line "    if ($script:color) { $result += \"COLOR=$($script:color)\" }" fn)
  (write-line "    if ($script:lw) { $result += \"LWT=$($script:lw)\" }" fn)
  (write-line "    $result += \"SCOPE=$($script:scope)\"" fn)
  (write-line "    foreach ($k in 'HATCH', 'FILL', 'SOLID') { $result += \"$k=$($script:hs[$k])\" }" fn)
  (write-line "} else {" fn)
  (write-line "    $result += 'CANCEL'" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "Set-Content -LiteralPath $OutputPath -Value $result -Encoding Default" fn)
  (close fn)
  (princ)
)

;; --- ブロック参照が使っている定義名(ダイナミックブロックは元の定義名も) --
(defun qsbc-ref-names (obj / nm en res)
  (setq nm (vla-get-Name obj))
  (setq res (list nm))
  (setq en (vl-catch-all-apply 'vla-get-EffectiveName (list obj)))
  (if (and (not (vl-catch-all-error-p en)) (/= (strcase en) (strcase nm)))
    (setq res (append res (list en)))
  )
  res
)

;; --- 選択ブロックから (調べる定義名一覧 表示用ブロック名一覧) を得る ------
(defun qsbc-get-selected-block-names (ss / i obj defs disp en)
  (setq i 0)
  (repeat (sslength ss)
    (setq obj (vlax-ename->vla-object (ssname ss i)))
    (foreach n (qsbc-ref-names obj)
      (if (not (member n defs)) (setq defs (cons n defs)))
    )
    (setq en (vla-get-EffectiveName obj))
    (if (not (member en disp)) (setq disp (cons en disp)))
    (setq i (1+ i))
  )
  (list (reverse defs) (reverse disp))
)

;; --- 外部参照の定義か ---------------------------------------------------
(defun qsbc-xref-p (blk / res)
  (setq res (vl-catch-all-apply 'vla-get-IsXRef (list blk)))
  (and (not (vl-catch-all-error-p res)) (= res :vlax-true))
)

;; --- ハッチング・ソリッドの種類 : "HATCH"(模様) / "FILL"(塗りつぶし・グラデーション) / "SOLID" / nil --
(defun qsbc-hs-kind (obj / on ed)
  (setq on (vla-get-ObjectName obj))
  (cond
    ((= on "AcDbHatch")
     (setq ed (entget (vlax-vla-object->ename obj)))
     (if (or (= (cdr (assoc 70 ed)) 1) (= (cdr (assoc 450 ed)) 1)) "FILL" "HATCH")
    )
    ((member on '("AcDbSolid" "AcDbTrace")) "SOLID")
  )
)

;; --- ブロック定義内の全エンティティを集める(入れ子ブロックも展開) ------
;; *qsbc-items* に (図形 所属ブロック定義 種類) を追加。同じ定義は1回だけ調べる
(defun qsbc-collect-entities (blkName / nm blk obj)
  (setq nm (strcase blkName))
  (if (not (member nm *qsbc-visited*))
    (progn
      (setq *qsbc-visited* (cons nm *qsbc-visited*))
      (setq blk (vl-catch-all-apply 'vla-item
                  (list (vla-get-Blocks (vla-get-ActiveDocument (vlax-get-acad-object))) blkName)))
      (if (and (not (vl-catch-all-error-p blk)) (not (qsbc-xref-p blk)))
        (vlax-for obj blk
          (setq *qsbc-items* (cons (list obj blk (qsbc-hs-kind obj)) *qsbc-items*))
          (if (= (vla-get-ObjectName obj) "AcDbBlockReference")
            (foreach n (qsbc-ref-names obj) (qsbc-collect-entities n))
          )
        )
      )
    )
  )
)

;; --- 色番号・線の太さを表示用文字列に変換 -------------------------------
(defun qsbc-color-to-str (val)
  (cond
    ((= val 0) "ByBlock")
    ((= val 256) "ByLayer")
    (T (itoa val))
  )
)
(defun qsbc-lwt-to-str (val)
  (cond
    ((= val -1) "ByLayer")
    ((= val -2) "ByBlock")
    ((= val -3) "既定")
    (T (strcat (rtos (/ val 100.0) 2 2) "mm"))
  )
)

;; --- 集めた図形から 画層・線種・色・線の太さの一覧 と ハッチング等の個数 を集計 --
;; 戻り値 : (画層一覧 線種一覧 色一覧 線の太さ一覧 模様数 塗りつぶし数 ソリッド数)
(defun qsbc-gather-data (items / layers ltypes colors lwts nH nF nS obj kind s)
  (setq layers '() ltypes '() colors '() lwts '() nH 0 nF 0 nS 0)
  (foreach it items
    (setq obj (car it) kind (caddr it))
    (setq s (vla-get-Layer obj))
    (if (not (member s layers)) (setq layers (cons s layers)))
    (setq s (vla-get-Linetype obj))
    (if (not (member s ltypes)) (setq ltypes (cons s ltypes)))
    (setq s (qsbc-color-to-str (vla-get-Color obj)))
    (if (not (member s colors)) (setq colors (cons s colors)))
    (setq s (qsbc-lwt-to-str (vla-get-Lineweight obj)))
    (if (not (member s lwts)) (setq lwts (cons s lwts)))
    (cond
      ((= kind "HATCH") (setq nH (1+ nH)))
      ((= kind "FILL") (setq nF (1+ nF)))
      ((= kind "SOLID") (setq nS (1+ nS)))
    )
  )
  (list (reverse layers) (reverse ltypes) (reverse colors) (reverse lwts) nH nF nS)
)

;; --- 図面の画層名("名前<TAB>色番号")・線種名の一覧(外部参照のものは除く) --
(defun qsbc-table-names (tbl / r nm res)
  (setq r (tblnext tbl T))
  (while r
    (setq nm (cdr (assoc 2 r)))
    (if (not (or (wcmatch nm "*|*") (member (strcase nm) '("BYLAYER" "BYBLOCK"))))
      (setq res (cons (if (= tbl "LAYER")
                        (strcat nm "\t" (itoa (abs (cdr (assoc 62 r)))))
                        nm)
                      res))
    )
    (setq r (tblnext tbl))
  )
  (reverse res)
)

;; --- 入力ファイル書き出し ---------------------------------------------
(defun qsbc-write-input-file (path names info entCount / fn)
  (setq fn (open path "w"))
  (write-line "###NAMES###" fn)
  (foreach s names (write-line s fn))
  (write-line "###LAYERS###" fn)
  (foreach s (nth 0 info) (write-line s fn))
  (write-line "###ALLLAYERS###" fn)
  (foreach s (qsbc-table-names "LAYER") (write-line s fn))
  (write-line "###LTYPES###" fn)
  (foreach s (nth 1 info) (write-line s fn))
  (write-line "###ALLLTYPES###" fn)
  (foreach s (qsbc-table-names "LTYPE") (write-line s fn))
  (write-line "###COLORS###" fn)
  (foreach s (nth 2 info) (write-line s fn))
  (write-line "###LWTS###" fn)
  (foreach s (nth 3 info) (write-line s fn))
  (write-line "###ENTCOUNT###" fn)
  (write-line (itoa entCount) fn)
  (write-line "###BLKCOUNT###" fn)
  (write-line (itoa (length names)) fn)
  (write-line "###HATCH###" fn)
  (write-line (itoa (nth 4 info)) fn)
  (write-line "###FILL###" fn)
  (write-line (itoa (nth 5 info)) fn)
  (write-line "###SOLID###" fn)
  (write-line (itoa (nth 6 info)) fn)
  (close fn)
  (princ)
)

;; --- 出力ファイル読み込み ---------------------------------------------
(defun qsbc-read-output-file (path / fn line result)
  (setq result '())
  (if (findfile path)
    (progn
      (setq fn (open path "r"))
      (while (setq line (read-line fn))
        (setq result (cons line result))
      )
      (close fn)
    )
  )
  (reverse result)
)

;; --- 集めた図形に画層・線種・色・線の太さを反映。戻り値は (成功数 失敗数) --
;; scope : "ALL" すべて / "HS" ハッチング・ソリッドのみ / "OTHER" それ以外のみ
(defun qsbc-apply-changes (items scope newLayer newLtype colorSpec lineweightSpec / okCnt errCnt obj kind res)
  (setq okCnt 0 errCnt 0)
  (foreach it items
    (setq obj (car it) kind (caddr it))
    (if (cond ((= scope "HS") kind) ((= scope "OTHER") (not kind)) (T T))
      (progn
        (setq res
          (vl-catch-all-apply
            '(lambda ()
               (if newLayer (vla-put-Layer obj newLayer))
               (if newLtype (vla-put-Linetype obj newLtype))
               (cond
                 ((= colorSpec "BYLAYER") (vla-put-Color obj 256))
                 ((= colorSpec "BYBLOCK") (vla-put-Color obj 0))
                 (colorSpec (vla-put-Color obj (atoi colorSpec)))
               )
               (cond
                 ((= lineweightSpec "BYLAYER") (vla-put-Lineweight obj -1))
                 ((= lineweightSpec "BYBLOCK") (vla-put-Lineweight obj -2))
                 ((= lineweightSpec "DEFAULT") (vla-put-Lineweight obj -3))
                 (lineweightSpec (vla-put-Lineweight obj (atoi lineweightSpec)))
               )
             )
            nil
          )
        )
        (if (vl-catch-all-error-p res)
          (setq errCnt (1+ errCnt))
          (setq okCnt (1+ okCnt))
        )
      )
    )
  )
  (list okCnt errCnt)
)

;; ============================================================
;;  ハッチング・ソリッドの分解(輪郭線化)
;;  作った図形は *qsbc-made* に入れ、途中で失敗したら消して元に戻す
;; ============================================================

(defun qsbc-2d (p) (list (car p) (cadr p)))
(defun qsbc-deg->rad (d) (* pi (/ d 180.0)))
(defun qsbc-ocs->wcs (p elev nrm) (trans (list (car p) (cadr p) elev) nrm 0))
(defun qsbc-normal (ed) (cond ((cdr (assoc 210 ed))) ('(0.0 0.0 1.0))))

;; --- 元の図形の画層・色・線種・線の太さを引き継ぐ ------------------------
(defun qsbc-copy-props (src dst)
  (foreach p '(Layer Color Linetype Lineweight LinetypeScale)
    (vl-catch-all-apply '(lambda () (vlax-put-property dst p (vlax-get-property src p))) nil)
  )
)

;; --- ブロック定義に閉じたポリラインを追加(pts は OCS の2D点、bulges は各頂点のふくらみ) --
(defun qsbc-add-poly (src blk pts bulges elev nrm / arr pl i)
  (if (>= (length pts) 2)
    (progn
      (setq arr (vlax-make-safearray vlax-vbDouble (cons 0 (1- (* 2 (length pts))))))
      (vlax-safearray-fill arr (apply 'append (mapcar 'qsbc-2d pts)))
      (setq pl (vla-AddLightWeightPolyline blk (vlax-make-variant arr)))
      (setq *qsbc-made* (cons pl *qsbc-made*))
      (setq i 0)
      (foreach b bulges
        (if (not (equal b 0.0 1e-12)) (vla-SetBulge pl i b))
        (setq i (1+ i))
      )
      (vla-put-Closed pl :vlax-true)
      (if (and elev (not (equal elev 0.0 1e-12))) (vla-put-Elevation pl elev))
      (if (not (equal nrm '(0.0 0.0 1.0) 1e-9)) (vla-put-Normal pl (vlax-3d-point nrm)))
      (qsbc-copy-props src pl)
    )
  )
)

;; --- entmakeで一時的に作った図形をブロック定義へコピーし、一時図形は消す --
(defun qsbc-entmake-into (blk src dxf / en arr res)
  (if (not (entmake dxf))
    (car 'qsbc-entmake-error) ; わざとエラーにして呼び出し元で捕まえる
  )
  (setq en (entlast))
  (setq arr (vlax-make-safearray vlax-vbObject '(0 . 0)))
  (vlax-safearray-put-element arr 0 (vlax-ename->vla-object en))
  (setq res (vl-catch-all-apply 'vla-CopyObjects
              (list (vla-get-ActiveDocument (vlax-get-acad-object)) arr blk)))
  (entdel en)
  (if (vl-catch-all-error-p res)
    (car 'qsbc-copy-error)
  )
  (foreach o (vlax-safearray->list (vlax-variant-value res))
    (setq *qsbc-made* (cons o *qsbc-made*))
    (qsbc-copy-props src o)
  )
)

;; --- 2Dソリッド → 閉じたポリライン(頂点順は 10→11→13→12) --------------
(defun qsbc-solid-outline (obj blk ed / p1 p2 p3 p4 pts)
  (setq p1 (cdr (assoc 10 ed)) p2 (cdr (assoc 11 ed))
        p3 (cdr (assoc 12 ed)) p4 (cdr (assoc 13 ed)))
  (setq pts (list p1 p2 p4))
  (if (not (equal p3 p4 1e-9)) (setq pts (append pts (list p3))))
  (qsbc-add-poly obj blk pts (mapcar '(lambda (p) 0.0) pts) (caddr p1) (qsbc-normal ed))
)

;; --- ハッチングのDXFデータを順に読む ------------------------------------
(defun qsbc-peek () (car (car *qsbc-dl*)))
(defun qsbc-take (code / p)
  (while (and *qsbc-dl* (/= (car (car *qsbc-dl*)) code))
    (setq *qsbc-dl* (cdr *qsbc-dl*))
  )
  (if (null *qsbc-dl*)
    (car 'qsbc-parse-error) ; 見つからない → わざとエラーにして呼び出し元で捕まえる
  )
  (setq p (car *qsbc-dl*) *qsbc-dl* (cdr *qsbc-dl*))
  (cdr p)
)

;; --- 境界エッジを1つ読む : (LINE 始点 終点) / (ARC 中心 半径 開始角 終了角 反時計回り) /
;;     (ELLIPSE 中心 長軸 比率 開始角 終了角 反時計回り) / (SPLINE 次数 有理 周期 ノット 制御点 重み) --
(defun qsbc-read-edge ( / typ deg rat per nk nc nf knots ctrl wts)
  (setq typ (qsbc-take 72))
  (cond
    ((= typ 1) (list 'LINE (qsbc-take 10) (qsbc-take 11)))
    ((= typ 2) (list 'ARC (qsbc-take 10) (qsbc-take 40) (qsbc-take 50) (qsbc-take 51) (qsbc-take 73)))
    ((= typ 3) (list 'ELLIPSE (qsbc-take 10) (qsbc-take 11) (qsbc-take 40) (qsbc-take 50) (qsbc-take 51) (qsbc-take 73)))
    ((= typ 4)
     (setq deg (qsbc-take 94) rat (qsbc-take 73) per (qsbc-take 74) nk (qsbc-take 95) nc (qsbc-take 96))
     (repeat nk (setq knots (cons (qsbc-take 40) knots)))
     (repeat nc
       (setq ctrl (cons (qsbc-take 10) ctrl))
       (if (= (qsbc-peek) 42) (setq wts (cons (qsbc-take 42) wts)))
     )
     ;; フィット点のデータがあれば読み飛ばす(境界の参照図形数の97と区別する)
     (if (and (= (qsbc-peek) 97) (member (car (cadr *qsbc-dl*)) '(11 12 13 72 97)))
       (progn
         (setq nf (qsbc-take 97))
         (repeat nf (qsbc-take 11))
         (if (= (qsbc-peek) 12) (qsbc-take 12))
         (if (= (qsbc-peek) 13) (qsbc-take 13))
       )
     )
     (list 'SPLINE deg rat per (reverse knots) (reverse ctrl) (reverse wts))
    )
    (T (car 'qsbc-parse-error))
  )
)

;; --- 線分と円弧だけのループ → 閉じたポリライン1本 -----------------------
;; 時計回り(73=0)の円弧は、角度が反転した座標系で記録されている
(defun qsbc-edges->poly (obj blk edges elev nrm / pts bulges c r sa ea sw a0 dir)
  (foreach e edges
    (if (eq (car e) 'LINE)
      (setq pts (cons (qsbc-2d (cadr e)) pts) bulges (cons 0.0 bulges))
      (progn
        (setq c (qsbc-2d (cadr e)) r (caddr e)
              sa (qsbc-deg->rad (nth 3 e)) ea (qsbc-deg->rad (nth 4 e)))
        (setq sw (- ea sa))
        (while (<= sw 1e-9) (setq sw (+ sw (* 2 pi))))
        (while (> sw (+ (* 2 pi) 1e-9)) (setq sw (- sw (* 2 pi))))
        (if (= (nth 5 e) 0) (setq a0 (- sa) dir -1.0) (setq a0 sa dir 1.0))
        (if (>= sw (- (* 2 pi) 1e-6))
          ;; 全円は半円2つに分ける
          (setq pts (cons (polar c (+ a0 (* dir pi)) r) (cons (polar c a0 r) pts))
                bulges (cons dir (cons dir bulges)))
          (setq pts (cons (polar c a0 r) pts)
                bulges (cons (* dir (/ (sin (/ sw 4.0)) (cos (/ sw 4.0)))) bulges))
        )
      )
    )
  )
  (qsbc-add-poly obj blk (reverse pts) (reverse bulges) elev nrm)
)

;; --- 楕円・スプラインを含むループ → エッジごとに図形を作る --------------
(defun qsbc-make-edge (obj blk e elev nrm ed / lay sa ea dxf)
  (setq lay (cons 8 (cdr (assoc 8 ed))))
  (setq dxf
    (cond
      ((eq (car e) 'LINE)
       (list '(0 . "LINE") lay
             (cons 10 (qsbc-ocs->wcs (cadr e) elev nrm))
             (cons 11 (qsbc-ocs->wcs (caddr e) elev nrm))))
      ((eq (car e) 'ARC)
       (if (= (nth 5 e) 0)
         (setq sa (- (nth 4 e)) ea (- (nth 3 e)))
         (setq sa (nth 3 e) ea (nth 4 e)))
       (list '(0 . "ARC") lay
             (cons 10 (list (car (cadr e)) (cadr (cadr e)) elev)) (cons 40 (caddr e))
             (cons 50 (qsbc-deg->rad sa)) (cons 51 (qsbc-deg->rad ea)) (cons 210 nrm)))
      ((eq (car e) 'ELLIPSE)
       (if (= (nth 6 e) 0)
         (setq sa (- 360.0 (nth 5 e)) ea (- 360.0 (nth 4 e)))
         (setq sa (nth 4 e) ea (nth 5 e)))
       (list '(0 . "ELLIPSE") '(100 . "AcDbEntity") lay '(100 . "AcDbEllipse")
             (cons 10 (qsbc-ocs->wcs (cadr e) elev nrm))
             (cons 11 (trans (list (car (caddr e)) (cadr (caddr e)) 0.0) nrm 0 T))
             (cons 210 nrm) (cons 40 (nth 3 e))
             (cons 41 (qsbc-deg->rad sa)) (cons 42 (qsbc-deg->rad ea))))
      ((eq (car e) 'SPLINE)
       (append
         (list '(0 . "SPLINE") '(100 . "AcDbEntity") lay '(100 . "AcDbSpline") (cons 210 nrm)
               (cons 70 (+ 8 (if (= (nth 2 e) 1) 4 0) (if (= (nth 3 e) 1) 2 0)))
               (cons 71 (nth 1 e)) (cons 72 (length (nth 4 e))) (cons 73 (length (nth 5 e))) '(74 . 0))
         (mapcar '(lambda (k) (cons 40 k)) (nth 4 e))
         (mapcar '(lambda (p) (cons 10 (qsbc-ocs->wcs p elev nrm))) (nth 5 e))
         (mapcar '(lambda (w) (cons 41 w)) (nth 6 e))))
    )
  )
  (qsbc-entmake-into blk obj dxf)
)

;; --- ハッチング → 境界ループごとに輪郭線を作る ---------------------------
(defun qsbc-hatch-outline (obj blk ed / nrm elev flag n pts bulges p b edges)
  (setq nrm (qsbc-normal ed))
  (setq elev (caddr (cdr (assoc 10 ed))))
  (if (not elev) (setq elev 0.0))
  (setq *qsbc-dl* (member (assoc 91 ed) ed))
  (repeat (qsbc-take 91)
    (setq flag (qsbc-take 92))
    (if (= (logand flag 2) 2)
      ;; ポリライン境界
      (progn
        (qsbc-take 72)
        (qsbc-take 73)
        (setq n (qsbc-take 93) pts '() bulges '())
        (repeat n
          (setq p (qsbc-take 10))
          (setq b (if (= (qsbc-peek) 42) (qsbc-take 42) 0.0))
          (setq pts (cons (qsbc-2d p) pts) bulges (cons b bulges))
        )
        (setq pts (reverse pts) bulges (reverse bulges))
        ;; 終点が始点と同じなら重複を除く
        (if (and (> (length pts) 2) (equal (car pts) (last pts) 1e-9))
          (setq pts (reverse (cdr (reverse pts))) bulges (reverse (cdr (reverse bulges))))
        )
        (qsbc-add-poly obj blk pts bulges elev nrm)
      )
      ;; エッジ境界
      (progn
        (setq n (qsbc-take 93) edges '())
        (repeat n (setq edges (cons (qsbc-read-edge) edges)))
        (setq edges (reverse edges))
        (if (vl-every '(lambda (e) (member (car e) '(LINE ARC))) edges)
          (qsbc-edges->poly obj blk edges elev nrm)
          (foreach e edges (qsbc-make-edge obj blk e elev nrm ed))
        )
      )
    )
  )
)

;; --- 1つの図形を分解。作った図形の数を返す -------------------------------
(defun qsbc-outline (obj blk / ed)
  (setq ed (entget (vlax-vla-object->ename obj)))
  (if (= (vla-get-ObjectName obj) "AcDbHatch")
    (qsbc-hatch-outline obj blk ed)
    (qsbc-solid-outline obj blk ed)
  )
  (length *qsbc-made*)
)

;; --- ハッチング・ソリッドの分解/削除。戻り値は (分解数 削除数 失敗数) -----
;; acts : (("HATCH" . "EXPLODE") ("FILL" . "DELETE") ("SOLID" . "KEEP")) の形
(defun qsbc-apply-hs (items acts / nExp nDel nErr obj act res)
  (setq nExp 0 nDel 0 nErr 0)
  (foreach it items
    (setq obj (car it))
    (setq act (if (caddr it) (cdr (assoc (caddr it) acts))))
    (cond
      ((= act "DELETE")
       (if (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list obj)))
         (setq nErr (1+ nErr))
         (setq nDel (1+ nDel))
       )
      )
      ((= act "EXPLODE")
       (setq *qsbc-made* nil)
       (setq res (vl-catch-all-apply 'qsbc-outline (list obj (cadr it))))
       (if (and (not (vl-catch-all-error-p res)) (> res 0)
                (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-Delete (list obj)))))
         (setq nExp (1+ nExp))
         (progn
           ;; 失敗したら作りかけの輪郭線を消し、元の図形は残す
           (foreach o *qsbc-made* (vl-catch-all-apply 'vla-Delete (list o)))
           (setq nErr (1+ nErr))
         )
       )
      )
    )
  )
  (setq *qsbc-made* nil *qsbc-dl* nil)
  (list nExp nDel nErr)
)

;; --- メインコマンド ----------------------------------------------------
(defun c:qsbc ( / *error* doc undoOn ss names items info entCount tmpDir inFile outFile ps1File
                outLines newLayer newLtype colorSpec lineweightSpec scope acts eqPos key val
                propChange hsChange applyResult hsResult)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
  (defun *error* (msg)
    (if (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*EXIT*,*キャンセル*"))
      (princ (strcat "\nエラー: " msg))
    )
    (if undoOn (vla-EndUndoMark doc))
    (princ)
  )
  (setq ss (ssget '((0 . "INSERT"))))
  (if (not ss)
    (princ "\n編集対象のブロックが見つかりません。")
    (progn
      (setq names (qsbc-get-selected-block-names ss))
      (setq *qsbc-visited* nil *qsbc-items* nil)
      (foreach bn (car names) (qsbc-collect-entities bn))
      (setq items (reverse *qsbc-items*))
      (setq *qsbc-visited* nil *qsbc-items* nil)
      (setq entCount (length items))

      (if (= entCount 0)
        (princ "\n対象となる図形が見つかりませんでした。")
        (progn
          (setq info (qsbc-gather-data items))
          (setq tmpDir (getenv "TEMP"))
          (setq inFile (strcat tmpDir "\\qsbc_input.txt"))
          (setq outFile (strcat tmpDir "\\qsbc_output.txt"))
          (setq ps1File (strcat tmpDir "\\qsbc_dialog.ps1"))
          (if (findfile outFile) (vl-file-delete outFile))

          (qsbc-write-input-file inFile (cadr names) info entCount)
          (qsbc-write-ps1-script ps1File)
          (qsbc-run-ps1 ps1File inFile outFile)

          (setq outLines (qsbc-read-output-file outFile))
          (setq scope "ALL" acts '())

          (if (and outLines (not (member "CANCEL" outLines)))
            (progn
              (foreach item outLines
                (setq eqPos (vl-string-search "=" item))
                (if eqPos
                  (progn
                    (setq key (substr item 1 eqPos))
                    (setq val (substr item (+ 2 eqPos)))
                    (cond
                      ((= key "LAYER") (setq newLayer val))
                      ((= key "LTYPE") (setq newLtype val))
                      ((= key "COLOR") (setq colorSpec val))
                      ((= key "LWT") (setq lineweightSpec val))
                      ((= key "SCOPE") (setq scope val))
                      ((member key '("HATCH" "FILL" "SOLID")) (setq acts (cons (cons key val) acts)))
                    )
                  )
                )
              )
              (setq propChange (or newLayer newLtype colorSpec lineweightSpec))
              (setq hsChange (vl-some '(lambda (a) (/= (cdr a) "KEEP")) acts))
              (if (or propChange hsChange)
                (progn
                  (vla-StartUndoMark doc)
                  (setq undoOn T)
                  (if propChange
                    (progn
                      (setq applyResult (qsbc-apply-changes items scope newLayer newLtype colorSpec lineweightSpec))
                      (princ (strcat "\n" (itoa (nth 0 applyResult)) "個の図形を更新しました。"))
                      (if (> (nth 1 applyResult) 0)
                        (princ (strcat "(" (itoa (nth 1 applyResult)) "個は変更できませんでした)"))
                      )
                    )
                  )
                  (if hsChange
                    (progn
                      (setq hsResult (qsbc-apply-hs items acts))
                      (princ (strcat "\nハッチング・ソリッド: 分解 " (itoa (nth 0 hsResult))
                                     "個 / 削除 " (itoa (nth 1 hsResult)) "個"))
                      (if (> (nth 2 hsResult) 0)
                        (princ (strcat "(" (itoa (nth 2 hsResult)) "個は処理できませんでした)"))
                      )
                    )
                  )
                  (vla-EndUndoMark doc)
                  (setq undoOn nil)
                  (command "_.REGENALL")
                )
                (princ "\n変更項目が選択されなかったため、何も更新しませんでした。")
              )
            )
            (princ "\nキャンセルされました。")
          )

          (if (findfile inFile) (vl-file-delete inFile))
          (if (findfile outFile) (vl-file-delete outFile))
          (if (findfile ps1File) (vl-file-delete ps1File))
        )
      )
    )
  )
  (princ)
)

(princ "\nQSBCコマンドをロードしました。ブロック内部の画層・線種・色・線の太さの一括変更、ハッチング・ソリッドの分解/削除は 'QSBC' と入力してください。")
(princ)
