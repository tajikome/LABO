;;; ============================================================
;;;  IJCAD用 AutoLISP (QSBCコマンド) - PowerShell/WPF UI版
;;;  ブロックエディタ(BEDIT)を開かずに、選択したブロックの内部にある
;;;  すべての線・図形の画層・線種・色・線の太さを一括変更する
;;;  UIはマテリアルデザイン風(アプリバー/カード/チップ/円形スウォッチ)
;;;  ※通常ブロックを対象に想定。ダイナミックブロックは未検証。
;;; ============================================================

(vl-load-com)

;; --- WScript.ShellでPowerShellを同期起動 -----------------------------
(defun qsbc-run-ps1 (ps1Path inPath outPath / wsh cmd)
  (setq wsh (vlax-create-object "WScript.Shell"))
  (setq cmd (strcat
              "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "
              "\"" ps1Path "\" -InputPath \"" inPath "\" -OutputPath \"" outPath "\""
            ))
  (vlax-invoke-method wsh 'Run cmd 0 :vlax-true)
  (vlax-release-object wsh)
  (princ)
)

;; --- 埋め込みPowerShell(WPF)スクリプトの書き出し ----------------------
(defun qsbc-write-ps1-script (path / fn)
  (setq fn (open path "w"))
  (write-line "[CmdletBinding()]" fn)
  (write-line "param(" fn)
  (write-line "    [Parameter(Mandatory=$true)][string]$InputPath," fn)
  (write-line "    [Parameter(Mandatory=$true)][string]$OutputPath" fn)
  (write-line ")" fn)
  (write-line "Add-Type -AssemblyName PresentationFramework" fn)
  (write-line "Add-Type -AssemblyName PresentationCore" fn)
  (write-line "Add-Type -AssemblyName WindowsBase" fn)
  (write-line "" fn)
  (write-line "function Read-InputData ($path) {" fn)
  (write-line "    $data = @{ Layers = @(); Ltypes = @(); Colors = @(); Lwts = @(); EntCount = 0; BlkCount = 0 }" fn)
  (write-line "    $cur = $null" fn)
  (write-line "    if (Test-Path -LiteralPath $path) {" fn)
  (write-line "        $lines = Get-Content -LiteralPath $path -Encoding Default" fn)
  (write-line "        foreach ($line in $lines) {" fn)
  (write-line "            if ($line -match '^###(.+)###$') {" fn)
  (write-line "                $cur = $Matches[1]" fn)
  (write-line "            } elseif ($cur -eq 'LAYERS' -and $line -ne '') {" fn)
  (write-line "                $data.Layers += $line" fn)
  (write-line "            } elseif ($cur -eq 'LTYPES' -and $line -ne '') {" fn)
  (write-line "                $data.Ltypes += $line" fn)
  (write-line "            } elseif ($cur -eq 'COLORS' -and $line -ne '') {" fn)
  (write-line "                $data.Colors += $line" fn)
  (write-line "            } elseif ($cur -eq 'LWTS' -and $line -ne '') {" fn)
  (write-line "                $data.Lwts += $line" fn)
  (write-line "            } elseif ($cur -eq 'ENTCOUNT' -and $line -ne '') {" fn)
  (write-line "                $data.EntCount = $line" fn)
  (write-line "            } elseif ($cur -eq 'BLKCOUNT' -and $line -ne '') {" fn)
  (write-line "                $data.BlkCount = $line" fn)
  (write-line "            }" fn)
  (write-line "        }" fn)
  (write-line "    }" fn)
  (write-line "    return $data" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function Get-AciRgb ([int]$idx) {" fn)
  (write-line "    switch ($idx) {" fn)
  (write-line "        1  { return @(255,0,0) }" fn)
  (write-line "        2  { return @(255,255,0) }" fn)
  (write-line "        3  { return @(0,255,0) }" fn)
  (write-line "        4  { return @(0,255,255) }" fn)
  (write-line "        5  { return @(0,0,255) }" fn)
  (write-line "        6  { return @(255,0,255) }" fn)
  (write-line "        7  { return @(255,255,255) }" fn)
  (write-line "        8  { return @(65,65,65) }" fn)
  (write-line "        9  { return @(128,128,128) }" fn)
  (write-line "        default {" fn)
  (write-line "            if ($idx -ge 250) {" fn)
  (write-line "                $g = 51 + [math]::Round((($idx - 250) / 5.0) * 204)" fn)
  (write-line "                return @($g,$g,$g)" fn)
  (write-line "            } else {" fn)
  (write-line "                $hue = (($idx - 10) % 30) * 12" fn)
  (write-line "                $light = 0.35 + ((($idx - 10) % 6) * 0.1)" fn)
  (write-line "                $h = $hue / 60.0" fn)
  (write-line "                $c = (1 - [math]::Abs((2 * $light) - 1))" fn)
  (write-line "                $x = $c * (1 - [math]::Abs(($h % 2) - 1))" fn)
  (write-line "                $m = $light - ($c / 2)" fn)
  (write-line "                switch ([int][math]::Floor($h)) {" fn)
  (write-line "                    0 { $r = $c; $g = $x; $b = 0 }" fn)
  (write-line "                    1 { $r = $x; $g = $c; $b = 0 }" fn)
  (write-line "                    2 { $r = 0; $g = $c; $b = $x }" fn)
  (write-line "                    3 { $r = 0; $g = $x; $b = $c }" fn)
  (write-line "                    4 { $r = $x; $g = 0; $b = $c }" fn)
  (write-line "                    default { $r = $c; $g = 0; $b = $x }" fn)
  (write-line "                }" fn)
  (write-line "                return @([int](($r + $m) * 255), [int](($g + $m) * 255), [int](($b + $m) * 255))" fn)
  (write-line "            }" fn)
  (write-line "        }" fn)
  (write-line "    }" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "$inputData = Read-InputData -path $InputPath" fn)
  (write-line "" fn)
  (write-line "$xaml = @'" fn)
  (write-line "<Window xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"" fn)
  (write-line "        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"" fn)
  (write-line "        Title=\"ブロック内部一括編集\" Height=\"800\" Width=\"1000\"" fn)
  (write-line "        WindowStartupLocation=\"CenterScreen\" ResizeMode=\"NoResize\"" fn)
  (write-line "        Background=\"#FFFAFAFA\" FontFamily=\"Roboto, Yu Gothic UI, Segoe UI\">" fn)
  (write-line "  <Window.Resources>" fn)
  (write-line "    <Style x:Key=\"ChipButton\" TargetType=\"Button\">" fn)
  (write-line "      <Setter Property=\"Background\" Value=\"#FFEEEEEE\"/>" fn)
  (write-line "      <Setter Property=\"Foreground\" Value=\"#FF212121\"/>" fn)
  (write-line "      <Setter Property=\"FontSize\" Value=\"13\"/>" fn)
  (write-line "      <Setter Property=\"BorderThickness\" Value=\"0\"/>" fn)
  (write-line "      <Setter Property=\"Padding\" Value=\"14,7\"/>" fn)
  (write-line "      <Setter Property=\"Margin\" Value=\"0,0,8,8\"/>" fn)
  (write-line "      <Setter Property=\"Cursor\" Value=\"Hand\"/>" fn)
  (write-line "      <Setter Property=\"Template\">" fn)
  (write-line "        <Setter.Value>" fn)
  (write-line "          <ControlTemplate TargetType=\"Button\">" fn)
  (write-line "            <Border x:Name=\"bd\" Background=\"{TemplateBinding Background}\" CornerRadius=\"16\" Padding=\"{TemplateBinding Padding}\">" fn)
  (write-line "              <ContentPresenter HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>" fn)
  (write-line "            </Border>" fn)
  (write-line "            <ControlTemplate.Triggers>" fn)
  (write-line "              <Trigger Property=\"IsMouseOver\" Value=\"True\">" fn)
  (write-line "                <Setter TargetName=\"bd\" Property=\"Background\" Value=\"#FFE0E0E0\"/>" fn)
  (write-line "              </Trigger>" fn)
  (write-line "            </ControlTemplate.Triggers>" fn)
  (write-line "          </ControlTemplate>" fn)
  (write-line "        </Setter.Value>" fn)
  (write-line "      </Setter>" fn)
  (write-line "    </Style>" fn)
  (write-line "    <Style x:Key=\"SwatchButton\" TargetType=\"Button\">" fn)
