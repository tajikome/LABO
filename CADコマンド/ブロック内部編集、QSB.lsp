  (write-line "    if ($val) {" fn)
  (write-line "        if ($val -eq 'BYLAYER' -or $val -eq 'BYBLOCK') { $key = $val } else { $key = 'CUSTOM' }" fn)
  (write-line "    }" fn)
  (write-line "    Set-ActiveChip $lineweightPanel $key" fn)
  (write-line "}" fn)
