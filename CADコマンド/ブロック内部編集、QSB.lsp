  (write-line "</Window>" fn)
  (write-line "'@" fn)
  (write-line "" fn)
  (write-line "$reader = [System.Xml.XmlNodeReader]::new([xml]$xaml)" fn)
  (write-line "$window = [Windows.Markup.XamlReader]::Load($reader)" fn)
  (write-line "" fn)
  (write-line "$infoText = $window.FindName('InfoText')" fn)
  (write-line "$currentLayersText = $window.FindName('CurrentLayersText')" fn)
  (write-line "$currentLtypesText = $window.FindName('CurrentLtypesText')" fn)
