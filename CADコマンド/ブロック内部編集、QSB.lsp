  (write-line "    elseif ($val) { Set-PreviewColor 255 158 158 158 }" fn)
  (write-line "    else { Set-PreviewColor 0 255 255 255 }" fn)
  (write-line "    $key = 'NONE'" fn)
  (write-line "    if ($val) { $key = $val }" fn)
