;;; ============================================================
;;;  IJCAD用 AutoLISP (QSBCコマンド) - PowerShell/WPF UI版
;;;  ブロックエディタ(BEDIT)を開かずに、選択したブロックの内部にある
;;;  すべての線・図形の画層・線種・色・線の太さを一括変更する
;;;  ブロック内のハッチング・2Dソリッドの分解・削除にも対応
;;;   - パターンハッチング / 塗りつぶしハッチング(SOLID・グラデーション) / 2Dソリッド
;;;     を、それぞれ「そのまま / 分解 / 削除」から選ぶ
;;;   - 分解 : 塗りつぶし・模様を消して、境界を輪郭線(ポリライン)で作り直す
;;;            (楕円・スプラインの境界は、その図形のまま作る)
;;;   - 画層などの変更の適用先を「すべて / ハッチング・ソリッドのみ / それ以外のみ」から選べる
;;;  入れ子のブロックの中身も対象。変更はまとめて1回の元に戻す(U)で戻せる
;;;  UI : 画層の絞り込み検索、図面内の全画層・全線種から選択、AutoCAD配色の色パレット、
;;;       線の太さは標準値から選択、変更内容のプレビュー、Enter=適用 / Esc=キャンセル
;;;  ※通常ブロックを対象に想定。ダイナミックブロックは未検証。
;;; ============================================================

(vl-load-com)

;; --- WScript.ShellでPowerShellを同期起動 -----------------------------
(defun qsbc-run-ps1 (ps1Path inPath outPath / wsh cmd)
  (setq wsh (vlax-create-object "WScript.Shell"))
  (setq cmd (strcat
              "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "
              "\"" ps1Path "\" -InputPath \"" inPath "\" -OutputPath \"" outPath "\""
            ))
  (vlax-invoke-method wsh 'Run cmd 0 :vlax-true)
  (vlax-release-object wsh)
  (princ)
)

;; --- 埋め込みPowerShell(WPF)スクリプトの書き出し ----------------------
(defun qsbc-write-ps1-script (path / fn)
  (setq fn (open path "w"))
  (write-line "[CmdletBinding()]" fn)
  (write-line "param(" fn)
  (write-line "    [Parameter(Mandatory=$true)][string]$InputPath," fn)
  (write-line "    [Parameter(Mandatory=$true)][string]$OutputPath" fn)
  (write-line ")" fn)
  (write-line "Add-Type -AssemblyName PresentationFramework" fn)
  (write-line "Add-Type -AssemblyName PresentationCore" fn)
  (write-line "Add-Type -AssemblyName WindowsBase" fn)
  (write-line "" fn)
  (write-line "$NONE = '__NONE__'" fn)
  (write-line "$TAB = [string][char]9" fn)
  (write-line "" fn)
  (write-line "function Read-InputData ($path) {" fn)
  (write-line "    $d = @{ Names = @(); Layers = @(); AllLayers = @(); Ltypes = @(); AllLtypes = @(); Colors = @(); Lwts = @(); EntCount = '0'; BlkCount = '0'; Hatch = '0'; Fill = '0'; Solid = '0' }" fn)
  (write-line "    $cur = $null" fn)
  (write-line "    if (Test-Path -LiteralPath $path) {" fn)
  (write-line "        foreach ($line in (Get-Content -LiteralPath $path -Encoding Default)) {" fn)
  (write-line "            if ($line -match '^###(.+)###$') { $cur = $Matches[1]; continue }" fn)
  (write-line "            if ($line -eq '') { continue }" fn)
  (write-line "            switch ($cur) {" fn)
  (write-line "                'NAMES'     { $d.Names += $line }" fn)
  (write-line "                'LAYERS'    { $d.Layers += $line }" fn)
  (write-line "                'ALLLAYERS' { $d.AllLayers += $line }" fn)
  (write-line "                'LTYPES'    { $d.Ltypes += $line }" fn)
  (write-line "                'ALLLTYPES' { $d.AllLtypes += $line }" fn)
  (write-line "                'COLORS'    { $d.Colors += $line }" fn)
  (write-line "                'LWTS'      { $d.Lwts += $line }" fn)
  (write-line "                'ENTCOUNT'  { $d.EntCount = $line }" fn)
  (write-line "                'BLKCOUNT'  { $d.BlkCount = $line }" fn)
  (write-line "                'HATCH'     { $d.Hatch = $line }" fn)
  (write-line "                'FILL'      { $d.Fill = $line }" fn)
  (write-line "                'SOLID'     { $d.Solid = $line }" fn)
  (write-line "            }" fn)
  (write-line "        }" fn)
  (write-line "    }" fn)
  (write-line "    return $d" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "# ---------- ACI(色番号) → RGB ----------" fn)
  (write-line "function Get-AciRgb ([int]$i) {" fn)
  (write-line "    switch ($i) {" fn)
  (write-line "        1 { return @(255,0,0) }" fn)
  (write-line "        2 { return @(255,255,0) }" fn)
  (write-line "        3 { return @(0,255,0) }" fn)
  (write-line "        4 { return @(0,255,255) }" fn)
  (write-line "        5 { return @(0,0,255) }" fn)
  (write-line "        6 { return @(255,0,255) }" fn)
  (write-line "        7 { return @(255,255,255) }" fn)
  (write-line "        8 { return @(128,128,128) }" fn)
  (write-line "        9 { return @(192,192,192) }" fn)
  (write-line "    }" fn)
  (write-line "    if ($i -le 0 -or $i -gt 255) { return @(255,255,255) }" fn)
  (write-line "    if ($i -ge 250) { $g = [int][math]::Round(51 + ($i - 250) * 40.8); return @($g,$g,$g) }" fn)
  (write-line "    $hue = [math]::Floor(($i - 10) / 10) * 15.0" fn)
  (write-line "    $shade = ($i - 10) % 10" fn)
  (write-line "    $vals = @(1.0, 0.8, 0.6, 0.5, 0.3)" fn)
  (write-line "    $v = $vals[[int][math]::Floor($shade / 2)]" fn)
  (write-line "    $s = 1.0" fn)
  (write-line "    if ($shade % 2 -eq 1) { $s = 0.5 }" fn)
  (write-line "    $c = $v * $s" fn)
  (write-line "    $h = $hue / 60.0" fn)
  (write-line "    $x = $c * (1 - [math]::Abs(($h % 2) - 1))" fn)
  (write-line "    $m = $v - $c" fn)
  (write-line "    switch ([int][math]::Floor($h)) {" fn)
  (write-line "        0 { $r = $c; $g = $x; $b = 0 }" fn)
  (write-line "        1 { $r = $x; $g = $c; $b = 0 }" fn)
  (write-line "        2 { $r = 0; $g = $c; $b = $x }" fn)
  (write-line "        3 { $r = 0; $g = $x; $b = $c }" fn)
  (write-line "        4 { $r = $x; $g = 0; $b = $c }" fn)
  (write-line "        default { $r = $c; $g = 0; $b = $x }" fn)
  (write-line "    }" fn)
  (write-line "    return @([int][math]::Round(($r + $m) * 255), [int][math]::Round(($g + $m) * 255), [int][math]::Round(($b + $m) * 255))" fn)
  (write-line "}" fn)
  (write-line "" fn)
  (write-line "function New-RgbBrush ($rgb) {" fn)
  (write-line "    return New-Object System.Windows.Media.SolidColorBrush ([System.Windows.Media.Color]::FromRgb([byte]$rgb[0], [byte]$rgb[1], [byte]$rgb[2]))" fn)
