  (write-line "" fn)
  (write-line "for ($i = 1; $i -le 255; $i++) {" fn)
  (write-line "    $rgb = Get-AciRgb $i" fn)
  (write-line "    $swatch = New-Object System.Windows.Controls.Button" fn)
